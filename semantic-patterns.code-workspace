{
	"folders": [
		{
			"path": "."
		}
	],
  "settings": {
    "python.defaultInterpreterPath": "${workspaceFolder}/.venv",
    "python-envs.pythonProjects": [
      {
        "path": ".",
        "envManager": "ms-python.python:venv"
      }
    ],
    "python-envs.workspaceSearchPaths": [
      "./.venv"
    ],
    "files.exclude": {
      "**/.git": true,
      "**/.DS_Store": true,
      "**/__pycache__": true,
      "**/*.log": true
    },
    "files.watcherExclude": {
      "**/.git/**": true,
      "**/__pycache__/**": true,
      "**/data/processed/**": true,
      "**/data/interim/**": true,
      "**/results/**": true,
      "**/output/**": true,
      "**/tmp/**": true,
      "**/paper/generated/**": true
    },
    "search.exclude": {
      "**/data/processed/**": true,
      "**/data/interim/**": true,
      "**/results/**": true,
      "**/output/**": true,
      "**/tmp/**": true
    },
    "chatgpt.openOnStartup": true
  }
}
