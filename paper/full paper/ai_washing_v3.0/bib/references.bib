@misc{donelson_strategic_2025,
	address = {Rochester, NY},
	type = {{SSRN} {Scholarly} {Paper}},
	title = {Strategic {AI} {Disclosures}: {Determinants} and {Consequences} of {Obfuscated} and {Overstated} {AI} {Investments}},
	shorttitle = {Strategic {AI} {Disclosures}},
	url = {https://papers.ssrn.com/abstract=5265257},
	doi = {10.2139/ssrn.5265257},
	abstract = {We examine the determinants, characteristics, and consequences of firms' Artificial Intelligence (AI) disclosures in their 10-Ks. Specifically, we compare firms' AI disclosures against their AI human capital investments and find two types of mismatches - firms that exaggerate AI activities ("AI washers") and firms that understate AI activities ("AI maskers") relative to their human capital investments. AI washers have greater external financing needs, weaker board governance, and attract more investment from technology mutual funds. Their AI disclosures are more prominent and ambiguously worded. However, some firms may have motives to understate their AI investments to avoid scrutiny of its social and environmental impacts. Consistent with these motives, AI maskers have more involvement with labor unions and greater ESG fund investment. We further find that AI maskers are more likely to have higher subsequent employee displacement and reduce job listings across both low and high skilled positions. We thus corroborate both regulatory concerns regarding AI washing and allegations that firms may obscure AI-induced consequences depending on their incentives.},
	language = {en},
	urldate = {2026-03-25},
	publisher = {Social Science Research Network},
	author = {Donelson, Dain C. and Kim, M. J. and Kim, Sydney Seulgi and Yip, Michael A.},
	month = may,
	year = {2025},
	keywords = {AI disclosures, AI maskers, AI washing, ESG ownership, Labor market, Labor Unions, Workforce Composition},
	file = {Full Text PDF:/Users/soheilkhodadadi/Zotero/storage/I2DHLLUQ/Donelson et al. - 2025 - Strategic AI Disclosures Determinants and Consequences of Obfuscated and Overstated AI Investments.pdf:application/pdf},
}

@article{crawford_strategic_1982,
	title = {Strategic {Information} {Transmission}},
	volume = {50},
	issn = {0012-9682},
	url = {https://www.jstor.org/stable/1913390},
	doi = {10.2307/1913390},
	abstract = {This paper develops a model of strategic communication, in which a better-informed Sender (S) sends a possibly noisy signal to a Receiver (R), who then takes an action that determines the welfare of both. We characterize the set of Bayesian Nash equilibria under standard assumptions, and show that equilibrium signaling always takes a strikingly simple form, in which S partitions the support of the (scalar) variable that represents his private information and introduces noise into his signal by reporting, in effect, only which element of the partition his observation actually lies in. We show under further assumptions that before S observes his private information, the equilibrium whose partition has the greatest number of elements is Pareto-superior to all other equilibria, and that if agents coordinate on this equilibrium, R's equilibrium expected utility rises when agents' preferences become more similar. Since R bases his choice of action on rational expectations, this establishes a sense in which equilibrium signaling is more informative when agents' preferences are more similar.},
	number = {6},
	urldate = {2026-03-25},
	journal = {Econometrica},
	publisher = {[Wiley, Econometric Society]},
	author = {Crawford, Vincent P. and Sobel, Joel},
	year = {1982},
	pages = {1431--1451},
}

